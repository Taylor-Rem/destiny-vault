# ==== Secrets — per-user Bungie API credentials & OAuth token (NEVER COMMIT) ====
.destiny_config.json
.destiny_token.json

# ==== Personal — your account info & builds. Copy from preferences.example.yaml ====
preferences.yaml

# ==== Personal output — reveals your inventory ====
# Matched by PATTERN, not by name: ad-hoc dumps (armor_out.txt, heavies.json, vw.txt…)
# kept slipping past an exact-name list and into a PUBLIC repo. Put throwaway output
# in scratch/ and it can never be committed by accident.
vault_report.json
VAULT_REPORT.md
*_report.json
*_cleanup_report.json
scratch/

# ==== Generated / cached ====
# .manifest_cache.json / .weapon_defs_cache.json / .armor_defs_cache.json are
# rebuilt on demand from the Bungie manifest
.manifest_cache.json
.weapon_defs_cache.json
.armor_defs_cache.json
__pycache__/
*.py[cod]

# ==== Virtual environments ====
venv/
.venv/
env/

# ==== OS cruft ====
.DS_Store
Thumbs.db

# ==== Personal god-roll rules (copy from rules.example.yaml) ====
rules.yaml
